# Default: normalize to LF everywhere
* text=auto eol=lf

# Keep CRLF for Windows-only scripts
*.bat eol=crlf
*.cmd eol=crlf
*.ps1 eol=crlf

# Be explicit for common text files
*.js  eol=lf
*.ts  eol=lf
*.tsx eol=lf
*.css eol=lf
*.md  eol=lf
*.json eol=lf
*.yml eol=lf
*.yaml eol=lf
pnpm-lock.yaml eol=lf
